# ChurchSMS Manager Environment Variables
# Omega Prayer Mission Church Mbuya, Uganda

# BULKSMSUGANDA_API_KEY: API key for Bulk SMS Uganda (https://app.bulksmsug.com)
# Used for real SMS delivery, balance verification, and delivery receipts.
# Configure this in the ChurchSMS Settings panel or set as an environment variable.
BULKSMSUGANDA_API_KEY=""

# CHURCHSMS_WEBHOOK_SECRET: Secret token for securing Google Forms/Sheets webhook submissions
# POST /api/google-sheets/webhook with header "x-webhook-secret: <CHURCHSMS_WEBHOOK_SECRET>"
CHURCHSMS_WEBHOOK_SECRET="change-this-to-a-secure-random-secret"

# ADMIN_EMAIL: Authorized church administrator email
ADMIN_EMAIL="amarvinmulindwa2003@gmail.com"

# APP_URL: The base URL where this applet is hosted
APP_URL="http://localhost:3000"
